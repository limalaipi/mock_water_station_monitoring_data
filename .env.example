# ============================================================
# Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Runtime environment ---
# Controls which path set is used for state_file and data_dir.
# Values: "local" | "airflow"
ENV=local

# --- State file and data output paths ---
STATE_FILE_LOCAL=./config.json
DATA_DIR_LOCAL=./data

STATE_FILE_AIRFLOW=/opt/airflow/jobs/water_station_monitoring/station_config.json
DATA_DIR_AIRFLOW=/opt/airflow/jobs/water_station_monitoring/station_data

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=maholan_dev
POSTGRES_USER=postgres
POSTGRES_PASS=

# --- Impala ---
IMPALA_HOST=
IMPALA_PORT=21050
IMPALA_DB=default
IMPALA_USER=
IMPALA_SCHEMA=default              # Impala database name used as schema

# --- Hive ---
HIVE_HOST=
HIVE_PORT=10000
HIVE_DB=DE-dataquality
HIVE_USER=
HIVE_AUTH=NONE                     # NONE | LDAP | KERBEROS
HIVE_SCHEMA=DE-dataquality         # Hive database name used as schema
# HIVE_KERBEROS_SERVICE_NAME=hive

# Execution engine. Leave BLANK to use the cluster default (safest).
# Only set 'tez' or 'spark' if that engine is actually installed on the
# cluster — otherwise queries fail with NoClassDefFoundError (e.g. Tez:
# 'org/apache/tez/runtime/api/Event'). This cluster runs MapReduce, so
# keep it blank (or 'mr'). MapReduce is slower (~15-20s job startup) but works.
HIVE_EXECUTION_ENGINE=
# Set to 1 only if a locked-down cluster rejects the perf SET statements
# applied on connect (vectorization, CBO, parallel, fetch-task).
# HIVE_SKIP_PERF_TUNING=0

# WebHDFS — used by HiveAdapter for fast bulk loading
# Namenode host (usually same as HIVE_HOST)
WEBHDFS_HOST=
# WebHDFS port: 50070 (older Hadoop) or 9870 (Hadoop 3.x)
WEBHDFS_PORT=9870
WEBHDFS_USER=                      # HDFS user (e.g. hdfs, hive, or your username)
# Staging directory on HDFS for temp CSV files
WEBHDFS_STAGING_DIR=/tmp/water_station_staging

# --- MySQL ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DB=
MYSQL_USER=
MYSQL_PASS=
# MYSQL_SCHEMA is set automatically from MYSQL_DB

# --- Oracle ---
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=
ORACLE_USER=
ORACLE_PASS=
# ORACLE_SCHEMA is set automatically from ORACLE_USER

# --- Microsoft SQL Server ---
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DB=
MSSQL_USER=
MSSQL_PASS=
MSSQL_SCHEMA=dbo                   # MSSQL default schema
# MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# --- IBM Db2 ---
DB2_HOST=
DB2_PORT=50000
DB2_DB=
DB2_USER=
DB2_PASS=
DB2_SCHEMA=                        # Db2 schema name
DB2_JDBC_JAR=./drivers/db2jcc4.jar # Path to db2jcc4.jar
